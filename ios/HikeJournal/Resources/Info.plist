<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>HikeJournal</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.hikejournal.callbacks</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(HIKEJOURNAL_CALLBACK_SCHEME)</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.hikejournal.google</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(GOOGLE_REVERSED_CLIENT_ID)</string>
			</array>
		</dict>
	</array>
	<key>GoogleIOSClientID</key>
	<string>$(GOOGLE_IOS_CLIENT_ID)</string>
	<key>GoogleReversedClientID</key>
	<string>$(GOOGLE_REVERSED_CLIENT_ID)</string>
	<key>GoogleServerClientID</key>
	<string>$(GOOGLE_SERVER_CLIENT_ID)</string>
	<key>HikeJournalAPIBaseURL</key>
	<string>$(HIKEJOURNAL_API_BASE_URL)</string>
	<key>HikeJournalAPIKey</key>
	<string>$(HIKEJOURNAL_API_KEY)</string>
	<key>HikeJournalCallbackScheme</key>
	<string>$(HIKEJOURNAL_CALLBACK_SCHEME)</string>
	<key>HikeJournalMapStyleURL</key>
	<string>$(HIKEJOURNAL_MAP_STYLE_URL)</string>
	<key>HikeJournalMapAttributionTitle</key>
	<string>$(HIKEJOURNAL_MAP_ATTRIBUTION_TITLE)</string>
	<key>HikeJournalMapAttributionURL</key>
	<string>$(HIKEJOURNAL_MAP_ATTRIBUTION_URL)</string>
	<key>HikeJournalMapStyleToken</key>
	<string>$(HIKEJOURNAL_MAP_STYLE_TOKEN)</string>
	<key>HikeJournalMapStyleTokenQueryItemName</key>
	<string>$(HIKEJOURNAL_MAP_STYLE_TOKEN_QUERY_ITEM_NAME)</string>
	<key>HikeJournalWebBaseURL</key>
	<string>$(HIKEJOURNAL_WEB_BASE_URL)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Allow HikeJournal to continue recording your route while the screen is locked or another app is open.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Allow HikeJournal to show where you are on the trail and geotag field observations.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Allow HikeJournal to save journal keepsakes to your photo library when you choose to export them.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Allow HikeJournal to browse original photos and videos so their dates and GPS locations can stay with your journal.</string>
	<key>NSSupportsLiveActivities</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UIAppFonts</key>
	<array>
		<string>CormorantGaramond.ttf</string>
		<string>SourceSans3.ttf</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.hikejournal.app.sync.refresh</string>
		<string>com.hikejournal.app.sync.processing</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>location</string>
		<string>processing</string>
	</array>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
		<key>UIImageName</key>
		<string>LaunchMark</string>
		<key>UIImageRespectsSafeAreaInsets</key>
		<true/>
	</dict>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
