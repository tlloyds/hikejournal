// Copy this file to Secrets.xcconfig and replace only the values you use.
// OAuth client IDs and callback schemes are public configuration, not secrets.
// Never place private keys, refresh tokens, service-role keys, or client secrets here.

HIKEJOURNAL_API_BASE_URL = https:/$()/api.example.com
HIKEJOURNAL_API_KEY =
HIKEJOURNAL_WEB_BASE_URL = https:/$()/www.example.com
HIKEJOURNAL_MAP_STYLE_URL = https:/$()/tiles.example.com/style.json
HIKEJOURNAL_MAP_ATTRIBUTION_TITLE = Example map provider
HIKEJOURNAL_MAP_ATTRIBUTION_URL = https:/$()/tiles.example.com/attribution
HIKEJOURNAL_MAP_STYLE_TOKEN = CONFIGURE_ME
HIKEJOURNAL_MAP_STYLE_TOKEN_QUERY_ITEM_NAME = access_token
GOOGLE_IOS_CLIENT_ID = 000000000000-example.apps.googleusercontent.com
GOOGLE_SERVER_CLIENT_ID = 000000000000-server.apps.googleusercontent.com
GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.000000000000-example
