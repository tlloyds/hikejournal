<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <exclude domain="sharedpref" path="hikejournal.xml" />
    </cloud-backup>
    <device-transfer>
        <!-- Android Keystore keys are device-bound; never copy ciphertext without its key. -->
        <exclude domain="sharedpref" path="hikejournal.xml" />
    </device-transfer>
</data-extraction-rules>
