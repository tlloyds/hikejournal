SUPABASE_URL=your_project_url
SUPABASE_KEY=your_server_only_service_role_key
SUPABASE_BUCKET=hike-journal
STORAGE_BACKEND=supabase
R2_ENDPOINT=
R2_BUCKET=hike-journal
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional legacy object locator. Keep the R2 bucket private; HikeJournal serves
# photos through expiring provider-signed URLs even when this value is present.
R2_PUBLIC_BASE_URL=
R2_REGION=auto
# Signed photo links are bounded to 5 minutes through 7 days.
MEDIA_SIGNED_URL_TTL_SECONDS=86400
INAT_ACCESS_TOKEN=
INAT_BASE_URL=https://api.inaturalist.org/v1
INAT_WEB_BASE_URL=https://www.inaturalist.org
INAT_DISCOVERY_BASE_URL=https://api.inaturalist.org/v2
INAT_CV_REQUEST_INTERVAL_SECONDS=2.5
# OAuth client values remain server-only. Register the public callback below
# with iNaturalist; the iOS app opens the flow through HikeJournal's API.
INAT_OAUTH_CLIENT_ID=
INAT_OAUTH_CLIENT_SECRET=
INAT_OAUTH_REDIRECT_URI=https://api.example.com/v1/inat/oauth/callback
INAT_OAUTH_AUTHORIZE_URL=https://www.inaturalist.org/oauth/authorize
INAT_OAUTH_TOKEN_URL=https://www.inaturalist.org/oauth/token
INAT_API_TOKEN_URL=https://www.inaturalist.org/users/api_token
SPECIES_DISCOVERY_ENABLED=true
# For commercial use, replace the default Open-Meteo endpoints with licensed
# provider endpoints and configure an API key where that provider requires one.
WEATHER_ENRICHMENT_ENABLED=true
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
OPEN_METEO_API_KEY=
WEATHER_REQUEST_TIMEOUT_SECONDS=20
USGS_WATER_API_ROOT=https://api.waterdata.usgs.gov/ogcapi/v0/collections
OUTDOOR_FORECAST_CACHE_MINUTES=15
OUTDOOR_USGS_CACHE_MINUTES=10
ADMIN_EMAILS=you@example.com
REQUIRE_GOOGLE_AUTH=false
GOOGLE_WEB_CLIENT_ID=your-google-oauth-web-client.apps.googleusercontent.com

# Native Android companion API. Keep this API beside Streamlit so infrastructure
# credentials never need to be included in the APK.
MOBILE_API_TOKEN=
MOBILE_AUTH_MODE=google
# Server-only signing secret for short-lived API sessions and rotating refresh sessions.
MOBILE_SESSION_SECRET=
# Sign in with Apple ID-token audience. For the native app this is normally the
# registered bundle ID (for example com.hikejournal.app), not a private key.
APPLE_SIGN_IN_CLIENT_ID=
# App Store transaction/Notification V2 verification. Download current DER
# Apple Root CA certificates from https://www.apple.com/certificateauthority/
# and mount them as read-only backend secrets; comma-separate absolute paths.
APPLE_APP_STORE_BUNDLE_ID=com.hikejournal.app
APPLE_APP_STORE_ENVIRONMENT=Sandbox
# Required when APPLE_APP_STORE_ENVIRONMENT=Production; this is the numeric
# App Store Connect Apple ID, not a bundle ID, key ID, or private key.
APPLE_APP_STORE_APP_ID=
APPLE_APP_STORE_ROOT_CA_PATHS=
# Production verification requires online certificate-revocation checks.
APPLE_APP_STORE_ONLINE_CHECKS=true
MOBILE_OWNER_EMAIL=
# Set this once to a stable, non-email identifier for the current personal
# owner. Changing it changes the durable-job owner namespace. Track B will map
# it to a real authenticated account subject.
MOBILE_OWNER_SUBJECT=
# Hosted deployments must use an explicit random pairing token and the durable
# mobile job migration. The container sets the first value automatically;
# Cloud Run is also detected automatically by the API.
# MOBILE_REQUIRE_EXPLICIT_TOKEN=true
# MOBILE_JOB_STORE_REQUIRED=true
# In-process recovery scans for due/expired jobs on this interval (clamped to
# 5-300 seconds). This is not a substitute for an external durable dispatcher.
# MOBILE_JOB_RECOVERY_INTERVAL_SECONDS=15
# Dependency readiness results are cached for this interval (clamped to 1-60
# seconds); individual dependency probes also have bounded timeouts.
# MOBILE_HEALTH_CACHE_SECONDS=10
# Optional additive compatibility guidance returned by /v1/config.
MOBILE_MIN_ANDROID_VERSION=
MOBILE_RECOMMENDED_ANDROID_VERSION=
# HTTP/LAN values are supported only by debug builds. A personal release build
# requires MOBILE_API_URL to be an absolute HTTPS URL.
MOBILE_API_URL=http://192.168.0.157:8506
MOBILE_WEB_URL=http://192.168.0.157:8505
# Required for a personal release build: an absolute HTTPS MapLibre style URL
# from the production provider selected by the owner. Debug builds use MapLibre
# demo tiles when this is blank; demo tiles are not accepted for release.
MOBILE_TRAIL_MAP_STYLE_URL=
# Public callback registered with iNaturalist for Android OAuth, e.g.
# https://hikejournal-mobile-abc.run.app/v1/inat/oauth/callback
MOBILE_INAT_OAUTH_REDIRECT_URI=
# Optional licensed MapLibre style URL. Satellite pack downloads remain disabled
# unless the configured provider explicitly permits offline storage.
MOBILE_SATELLITE_OFFLINE_STYLE_URL=

# Optional production APK signing inputs. Release builds intentionally omit the
# companion pairing key; enter it on-device after installation. When all four
# signing inputs are set, the expected signer digest below is also required
# before build_android.command promotes the APK to the canonical release name.
ANDROID_KEYSTORE_PATH=
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=
ANDROID_KEY_PASSWORD=
# Public SHA-256 certificate digest used to pin the expected APK signer during
# release verification. Colons are optional; this is not a secret.
ANDROID_EXPECTED_SIGNER_SHA256=
# Optional APK signing-key rotation inputs. Keep these configured while the app
# supports upgrades from installations signed by the previous certificate.
# The lineage file is created once with `apksigner rotate`; it contains the
# authorized certificate history but no private keys.
ANDROID_SIGNING_LINEAGE_PATH=
ANDROID_PREVIOUS_KEYSTORE_PATH=
ANDROID_PREVIOUS_KEYSTORE_PASSWORD=
ANDROID_PREVIOUS_KEY_ALIAS=
ANDROID_PREVIOUS_KEY_PASSWORD=
# APK Signature Scheme v3 key rotation starts at Android 9 / API 28.
ANDROID_SIGNING_ROTATION_MIN_SDK=28
